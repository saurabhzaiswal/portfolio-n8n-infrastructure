    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\n\nfunction cleanText(value, maxLength) {\n  return String(value ?? '')\n    .replace(/\\u0000/g, '')\n    .replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<[^>]*>/g, '')\n    .replace(/\\s{3,}/g, ' ')\n    .trim()\n    .slice(0, maxLength);\n}\n\nfunction isValidEmail(email) {\n  return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/i.test(email);\n}\n\nfunction containsSuspiciousContent(value) {\n  const suspiciousPatterns = [\n    /javascript:/i,\n    /data:text\\/html/i,\n    /onerror\\s*=/i,\n    /onclick\\s*=/i,\n    /onload\\s*=/i,\n    /<script/i,\n    /<iframe/i,\n  ];\n\n  return suspiciousPatterns.some((pattern) => pattern.test(value));\n}\n\nconst rawName = String(body.name ?? '');\nconst rawEmail = String(body.email ?? '');\nconst rawSubject = String(body.subject ?? '');\nconst rawMessage = String(body.message ?? '');\nconst turnstileToken = String(\n  body.turnstileToken ??\n  body['cf-turnstile-response'] ??\n  ''\n).trim();\n\nconst name = cleanText(rawName, 100);\nconst email = cleanText(rawEmail, 254).toLowerCase();\nconst subject = cleanText(rawSubject, 150);\nconst message = cleanText(rawMessage, 5000);\nconst website = cleanText(body.website, 500);\n\nconst errors = [];\n\n\nif (!name) {\n  errors.push('Name is required.');\n} else if (name.length < 2) {\n  errors.push('Name must contain at least 2 characters.');\n}\n\nif (!email) {\n  errors.push('Email is required.');\n} else if (!isValidEmail(email)) {\n  errors.push('Please enter a valid email address.');\n}\n\nif (!subject) {\n  errors.push('Subject is required.');\n} else if (subject.length < 3) {\n  errors.push('Subject must contain at least 3 characters.');\n}\n\nif (!message) {\n  errors.push('Message is required.');\n} else if (message.length < 10) {\n  errors.push('Message must contain at least 10 characters.');\n}\n\nif (!turnstileToken) {\n  errors.push('Security verification is required.');\n}\n\nconst hasSuspiciousContent = [\n  rawName,\n  rawEmail,\n  rawSubject,\n  rawMessage,\n].some(containsSuspiciousContent);\n\nif (hasSuspiciousContent) {errors.push('The submitted content contains unsupported markup.');}\n\nreturn {\n  json: {\n    name,\n    email,\n    subject,\n    message,\n    isSpam: website.length > 0,\n    turnstileToken,\n\n    isValid: errors.length === 0,\n    errors,\n\n    hasSuspiciousContent,\n\n    timestamp: new Date().toISOString(),\n\n    ip:\n      $json.headers?.['x-forwarded-for']\n        ?.split(',')[0]\n        ?.trim() ?? '',\n\n    userAgent: $json.headers?.['user-agent'] ?? '',\n  },\n};"
      },
